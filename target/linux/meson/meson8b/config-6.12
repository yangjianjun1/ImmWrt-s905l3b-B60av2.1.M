# ===== Platform =====
CONFIG_ARCH_MESON=y
CONFIG_MESON_GX_PM_DOMAINS=y
CONFIG_MESON_SM=y
CONFIG_DRM_MESON=y
CONFIG_DRM_DW_HDMI=y
CONFIG_DRM_MESON_DW_HDMI=y

# ===== Timer / Clk / Regmap =====
CONFIG_COMMON_CLK_AMLOGIC=y
CONFIG_COMMON_CLK_GXBB=y
CONFIG_REGMAP_MMIO=y
CONFIG_PINCTRL_MESON=y
CONFIG_PINCTRL_MESON_GXL=y

# ===== MMC / eMMC (启动必须) =====
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_BLOCK_MINORS=32
CONFIG_SDIO_UART=n
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_MESON_GX=y
CONFIG_MMC_HS200_1_8V=y
CONFIG_MMC_HS400_1_8V=y

# ===== Ethernet / STMMAC =====
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_GENERIC=y
CONFIG_STMMAC_SELFTESTS=n
CONFIG_PHYLIB=y
CONFIG_FIXED_PHY=y
CONFIG_SWPHY=y

# GXL 内部 PHY（S905L3B 常见板载）
CONFIG_MESON_GXL_PHY=y
# 外置 RTL8211F
CONFIG_REALTEK_PHY=y

# ===== USB (DWC3) =====
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_HOST=y
CONFIG_USB_DWC3_MESON_G12A=y
CONFIG_USB_DWC3_OF_SIMPLE=y

# USB2 PHY (GXL/GXM)
CONFIG_PHY_MESON_GXL_USB2=y
CONFIG_PHY_MESON_G12A_USB3=y
CONFIG_USB_PHY=y
CONFIG_NOP_USB_XCEIV=y

# USB 存储
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y

# ===== Serial / Earlycon (调试) =====
CONFIG_SERIAL_MESON=y
CONFIG_SERIAL_MESON_CONSOLE=y
CONFIG_DEBUG_AMLOGIC_UART=y
CONFIG_EARLYCON=y

# ===== Filesystems =====
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_VFAT_FS=m
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_EXFAT_FS=m
CONFIG_NLS_CODEPAGE_437=m
CONFIG_NLS_UTF8=m

# ===== Crypto (Passwall / wireguard 依赖) =====
CONFIG_CRYPTO_AEGIS128=n
CONFIG_CRYPTO_CHACHA20POLY1305=m
CONFIG_CRYPTO_LIB_CHACHA=m
CONFIG_CRYPTO_POLY1305=m
CONFIG_CRYPTO_AES_ARM64=y
CONFIG_CRYPTO_GHASH_ARM64_CE=y

# ===== zram =====
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y

# ===== Misc =====
CONFIG_GPIO_SYSFS=y
CONFIG_THERMAL=y
CONFIG_MESON_THERMAL=y
CONFIG_WATCHDOG=y
CONFIG_MESON_GXBB_WATCHDOG=y
