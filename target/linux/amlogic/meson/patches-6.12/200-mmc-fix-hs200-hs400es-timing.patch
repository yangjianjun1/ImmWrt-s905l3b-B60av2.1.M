From: B60 Maintainer <builder@local>
Subject: mmc: meson-gx: fix HS200/HS400ES tuning for S905L3b

S905L3B eMMC controller needs fixed tunning phase,
otherwise HS200/HS400ES mode may fail with CRC errors.

--- a/drivers/mmc/host/meson-gx-mmc.c
+++ b/drivers/mmc/host/meson-gx-mmc.c
@@ -18,6 +18,7 @@
 #include <linux/of_device.h>
 #include <linux/platform_device.h>
 #include <linux/pm_runtime.h>
+#include <linux/bitfield.h>
 
 #include <linux/mmc/host.h>
 #include <linux/mmc/mmc.h>
@@ -128,6 +129,9 @@
 #define SD_EMMC_CFG_CMD_GAP_MASK	GENMASK(15, 13)
 #define SD_EMMC_CFG_ERR_OFF		BIT(16)
 
+/* S905L3B specific: fixed tuning phase */
+#define MESON_S905L3B_FIXED_TUNING_PHASE	12
+
 struct meson_gx_mmc {
 	struct mmc_host		*mmc;
 	struct device		*dev;
@@ -640,6 +644,18 @@ static int meson_mmc_execute_tuning(struct mmc_host *mmc, u32 opcode)
 	if (host->data->tx_tuning_reset)
 		host->data->tx_tuning_reset(host);
 
+	/*
+	 * S905L3B: skip auto-tuning, use fixed phase for HS200/HS400ES.
+	 * Auto tuning sometimes picks an unstable window on this SoC.
+	 */
+	if (of_device_is_compatible(host->dev->of_node, "amlogic,s905l3b")) {
+		writel_relaxed(
+			FIELD_PREP(SD_EMMC_CFG_TX_TUNEN, 1) |
+			FIELD_PREP(SD_EMMC_CFG_TX_TUNEN_PHASE,
+				   MESON_S905L3B_FIXED_TUNING_PHASE),
+			host->regs + SD_EMMC_CFG);
+		return 0;
+	}
+
 	return meson_mmc_find_tuning_window(mmc);
 }
