CONFIG_TARGET_amlogic=y
CONFIG_TARGET_amlogic_meson=y
CONFIG_TARGET_amlogic_meson_meson=y
CONFIG_TARGET_DEVICE_amlogic_meson_m302a=y

# 架构
CONFIG_TARGET_ARCH_PACKAGES="aarch64_generic"
CONFIG_ARCH_arm64=y

# 内核基础
CONFIG_KERNEL_BUILD_DOMAIN=""
CONFIG_KERNEL_BUILD_HOST="openwrt"
CONFIG_KERNEL_BUILD_USER="builder"
CONFIG_KERNEL_DEBUG_INFO=n
CONFIG_KERNEL_KALLSYMS=n
CONFIG_KERNEL_PRINTK=y

# 文件系统
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-autofs4=y

# KSMBD SMB共享（你需要的）
CONFIG_PACKAGE_kmod-fs-ksmbd=y
CONFIG_PACKAGE_ksmbd-utils=y
CONFIG_PACKAGE_luci-app-ksmbd=y

# USB 存储（U盘启动必需）
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y

# 晶晨宝盒（U盘启动后安装到eMMC核心）
CONFIG_PACKAGE_luci-app-amlogic=y
CONFIG_PACKAGE_luci-i18n-amlogic-zh-cn=y

# Luci基础 & 中文
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-light-zh-cn=y

# 网络基础
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_ipv6helper=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_iptables-nft=y

# 工具集
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_vim-full=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_mountd=y

# 时区
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_zoneinfo-asia-shanghai=y

# 关闭重量级组件，减少编译时间
CONFIG_PACKAGE_docker=n
CONFIG_PACKAGE_dockerd=n
CONFIG_PACKAGE_kmod-docker=n
CONFIG_PACKAGE_freeswitch=n
CONFIG_PACKAGE_kamailio=n
CONFIG_PACKAGE_siproxd=n
CONFIG_PACKAGE_rtpengine=n

# 不构建调试符号
CONFIG_DEBUG=n
CONFIG_DEBUG_FS=n
