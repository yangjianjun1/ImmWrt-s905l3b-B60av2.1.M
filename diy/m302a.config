# ============================================================
# M302A / B860AV2.1-M  (Amlogic S905L3B, eMMC) 编译配置
# 上游：ImmortalWrt openwrt-24.10  架构：aarch64_cortex-a53
# 说明：本文件在 CI 中被复制为源码根目录 .config，随后 make defconfig
#       自动补齐依赖；少量不存在的配置项会被 defconfig 忽略，属正常。
# ============================================================

# ---------- 目标平台 / 机型（必须与 isos1.sh 的 Device/m302a 对应） ----------
CONFIG_TARGET_amlogic=y
CONFIG_TARGET_amlogic_meson=y
CONFIG_TARGET_DEVICE_amlogic_meson_m302a=y
CONFIG_TARGET_BOARD="amlogic"
CONFIG_TARGET_SUBTARGET="meson"
CONFIG_TARGET_PROFILE="DEVICE_amlogic_meson_m302a"

# ---------- 架构 / 浮点 / 工具链 ----------
CONFIG_ARCH_64BIT=y
CONFIG_aarch64=y
CONFIG_CPU_TYPE="cortex-a53"
CONFIG_KERNEL_CC_OPTIMIZE_FOR_PERFORMANCE_O3=y

# ---------- 文件系统 / 镜像 ----------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_LZMA=y
CONFIG_IMAGEOPT=y

# ---------- 基础系统 / 包管理 ----------
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-stat=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_sh=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-loop=y
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-sdhci=y

# ---------- LuCI 界面 ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-network=y
CONFIG_PACKAGE_luci-app-system=y
CONFIG_PACKAGE_luci-app-diskman=y

# ---------- 网络基础 ----------
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE-firewall=y
CONFIG_PACKAGE_dnsmasq=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_pppoe=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152-vendor=y

# ---------- SMB / KSMBD 共享（重点） ----------
CONFIG_PACKAGE_kmod-fs-ksmbd=y
CONFIG_PACKAGE_kmod-fs-ksmbd-utils=y
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_libnl=y
CONFIG_PACKAGE_libnl-tiny=y

# ---------- 存储 / 文件系统支持 ----------
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-cp850=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-uhci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y

# ---------- 常用工具 ----------
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_zip=y
CONFIG_PACKAGE_procps=y
CONFIG_PACKAGE_procps-ps=y
CONFIG_PACKAGE_procps-top=y
CONFIG_PACKAGE_vim=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_crontab=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ca-bundle=y

# ---------- 时区 / 语言 ----------
CONFIG_PACKAGE_zoneinfo-asia=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# ---------- 关闭用不到的大组件（按需保留/注释） ----------
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_kmod-docker is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-openclash is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_freeswitch is not set
# CONFIG_PACKAGE_kamailio is not set

