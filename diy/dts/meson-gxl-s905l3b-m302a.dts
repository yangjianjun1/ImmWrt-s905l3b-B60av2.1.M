/dts-v1/;

#include <dt-bindings/input/input.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/clock/meson-gxl.h>
#include "meson-gxl.dtsi"

/ {
	model = "Amlogic S905L3B";
	compatible = "amlogic,s905l3b", "amlogic,meson-gxl";

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x00000000 0x0 0x70000000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0x4000000>; /* 64MB CMA */
			alignment = <0x100000>;
			linux,cma-default;
		};
	};

	aliases {
		serial0 = &uart_AO;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	leds {
		compatible = "gpio-leds";
		status {
			gpios = <&gpio GPIOAO_7 GPIO_ACTIVE_LOW>;
			default-state = "on";
		};
	};
};

&cbus {
	pmu: pmu@0 {
		compatible = "amlogic,meson-gxl-pmu";
		reg = <0x0 0x0 0x0 0x100>;
	};
};

&uart_AO {
	status = "okay";
	pinctrl-0 = <&uart_ao_pins>;
	pinctrl-names = "default";
};

&pinctrl {
	uart_ao_pins: uart-ao-pins {
		mux {
			groups = "uart_ao";
			function = "uart_ao";
		};
	};
};

&emmc {
	status = "okay";
	disable-wp;
	cap-mmc-highspeed;
	cap-sd-highspeed;
	max-frequency = <100000000>;
	no-sdio;
	no-sd;
	pinctrl-0 = <&emmc_pins>;
	pinctrl-names = "default";
};

&usb0 {
	status = "okay";
};

&usb1 {
	status = "okay";
};

&usb2 {
	status = "okay";
};

&dwc2 {
	dr_mode = "host";
	status = "okay";
};

&rtc {
	status = "okay";
};

&hdmi {
	status = "okay";
	hdmi-supply = <&vddio_1v8>;
	hdmi-timings {
		native-mode = <&timing_1080p60>;
		timing_1080p60: timing1080p60 {
			clock-frequency = <148500000>;
			hactive = <1920>;
			vactive = <1080>;
			hsync-len = <44>;
			hfront-porch = <88>;
			hback-porch = <148>;
			vsync-len = <5>;
			vfront-porch = <4>;
			vback-porch = <36>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
			pixelclk-active = <0>;
		};
	};
};

&vddio_1v8 {
	status = "okay";
};

&vddio_3v3 {
	status = "okay";
};

&ir {
	status = "okay";
	pinctrl-0 = <&ir_recv_pins>;
	pinctrl-names = "default";
};
