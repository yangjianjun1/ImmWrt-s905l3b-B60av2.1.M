# ============================================================================
# M302A / S905L3B 通用 rootfs 配置（armsr armv8 generic，仅用于打包前的 rootfs.tar.gz）
# 说明：这一步编译的是“通用 ARM64 根文件系统”，不含 amlogic 板级适配；
#       板级内核 / u-boot / dtb 由打包阶段（ophub action）按 board=s905l3b 注入。
# 编译产物：bin/targets/armsr/armv8/*-generic-rootfs.tar.gz
# ============================================================================

# ---- 目标架构（必须与官方 armsr 一致，不要改成 amlogic/meson-gxl）----
CONFIG_TARGET_armsr=y
# CONFIG_TARGET_armsr_armv7 is not set
CONFIG_TARGET_armsr_armv8=y
CONFIG_TARGET_armsr_armv8_DEVICE_generic=y
CONFIG_TARGET_BOARD="armsr"
CONFIG_TARGET_SUBTARGET="armv8"
CONFIG_TARGET_PROFILE="DEVICE_generic"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"

# ---- 镜像格式：只需要 tar.gz 根文件系统，打包脚本会重新分区 ----
CONFIG_USES_TARGZ=y
CONFIG_TARGET_ROOTFS_TARGZ=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
CONFIG_TARGET_ROOTFS_PARTSIZE=512

# ---- 全局精简 ----
CONFIG_BUILD_PATENTED=n
CONFIG_BUILD_NLS=n
CONFIG_PACKAGE_documentation=n
CONFIG_PACKAGE_sources=n
CONFIG_IPV6=n

# ---- 基础系统 ----
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_libubus=y
CONFIG_PACKAGE_ubusd=y
CONFIG_PACKAGE_libuci=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_odhcpd=y
CONFIG_PACKAGE_odhcpd-ipv6only=n

# ---- 防火墙 ----
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y

# ---- SSH ----
CONFIG_PACKAGE_dropbear=y

# ---- LuCI 最小网页 ----
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_luci-i18n-base=n

# ---- USB / 存储（U盘启动、挂载 eMMC/U盘需要）----
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=n

# ---- 可选：SMB 共享（需要 NAS 时把下面两行改为 y）----
# CONFIG_PACKAGE_kmod-fs-ksmbd=y
# CONFIG_PACKAGE_ksmbd-server=y

# ---- 关闭不需要的大包 ----
CONFIG_PACKAGE_docker=n
CONFIG_PACKAGE_dockerd=n
CONFIG_PACKAGE_ddns-scripts=n
CONFIG_PACKAGE_samba4-server=n
CONFIG_PACKAGE_ppp=n
CONFIG_PACKAGE_pppoe=n
CONFIG_PACKAGE_tcpdump=n
CONFIG_PACKAGE_iperf3=n
CONFIG_PACKAGE_htop=n
CONFIG_PACKAGE_strace=n
CONFIG_PACKAGE_avahi-daemon=n
CONFIG_PACKAGE_mdnsd=n
CONFIG_PACKAGE_frp=n
CONFIG_PACKAGE_tailscale=n
CONFIG_PACKAGE_wireguard-tools=n
CONFIG_PACKAGE_openvpn=n
CONFIG_PACKAGE_luci-app-firewall=n
CONFIG_PACKAGE_luci-app-statistics=n
CONFIG_PACKAGE_luci-app-ddns=n
CONFIG_PACKAGE_luci-app-docker=n
CONFIG_PACKAGE_luci-app-samba=n
