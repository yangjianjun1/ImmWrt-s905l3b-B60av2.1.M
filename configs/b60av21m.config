#
# OpenWrt / ImmortalWrt 编译配置
# 设备: 中兴 B60av2.1.M (S905L3B / meson-gxl)
# 启动方式: U 盘启动 (只做 USB，不写 eMMC)
# 基线: 复用 OneCloud (meson8b) 设备定义
#

# ========== 构建系统基础 ==========
CONFIG_MODULES=y
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_DEVEL=y
CONFIG_TOOLCHAINOPTS=y
CONFIG_TARGET_OPTIMIZATION="-Os -pipe"
CONFIG_EXTRA_OPTIMIZATION="-fno-caller-saves -fno-plt"
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y

# ========== 目标平台 ==========
CONFIG_TARGET_meson=y
CONFIG_TARGET_meson_meson8b=y
CONFIG_TARGET_meson_meson8b_DEVICE_thunder-onecloud=y

# ========== 内核版本（与补丁目录 patches-6.6 对应）==========
CONFIG_LINUX_6_6=y
CONFIG_LINUX_VERSION="6.6"

# ========== 内核内置选项（U 盘启动关键）==========
CONFIG_KERNEL_EXT4_FS=y
CONFIG_KERNEL_EXT4_FS_POSIX_ACL=y
CONFIG_KERNEL_EXT4_FS_SECURITY=y
CONFIG_KERNEL_VFAT_FS=y
CONFIG_KERNEL_FAT_FS=y
CONFIG_KERNEL_SCSI_MOD=y
CONFIG_KERNEL_BLK_DEV_SD=y
CONFIG_KERNEL_USB_SUPPORT=y
CONFIG_KERNEL_USB_STORAGE=y
CONFIG_KERNEL_USB_STORAGE_DEBUG=n
CONFIG_KERNEL_USB_XHCI_HCD=y
CONFIG_KERNEL_USB_XHCI_PCI=y
CONFIG_KERNEL_USB_EHCI_HCD=y
CONFIG_KERNEL_USB_OHCI_HCD=y
CONFIG_KERNEL_USB_DWC2=y
CONFIG_KERNEL_USB_DWC3=y
CONFIG_KERNEL_USB_GADGET=y
CONFIG_KERNEL_MMC=y
CONFIG_KERNEL_MMC_BLOCK=y
CONFIG_KERNEL_MMC_BLOCK_BOUNCE=y
CONFIG_KERNEL_ARM_APPENDED_DTB=y
CONFIG_KERNEL_ARM_ATAG_DTB_COMPAT=y
CONFIG_KERNEL_CMDLINE_FORCE=n
CONFIG_KERNEL_DEBUG_FS=y
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_NET_NS=y

# ========== 启动参数（配合 pack-usb.sh 分区方案）==========
CONFIG_KERNEL_CMDLINE="console=ttyAML0,115200 root=/dev/sda2 rootfstype=ext4 rootwait rw"

# ========== USB / 存储驱动 ==========
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-xhci-pci=y
CONFIG_PACKAGE_kmod-usb-xhci-mtk=y
CONFIG_PACKAGE_kmod-scsi-core=y
CONFIG_PACKAGE_kmod-scsi-generic=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_blkid=y

# ========== 文件系统 ==========
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ntfs=y
CONFIG_PACKAGE_kmod-nls-base=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y

# ========== 分区/格式化工具 ==========
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_usbutils=y

# ========== 网络基础 ==========
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-phylink=y
CONFIG_PACKAGE_kmod-ethernet=y
CONFIG_PACKAGE_kmod-stmmac=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=y
CONFIG_PACKAGE_kmod-slhc=y
CONFIG_PACKAGE_resolveip=y

# ========== LuCI Web 管理 ==========
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y

# ========== 系统基础工具 ==========
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_vim=y
CONFIG_PACKAGE_tmux=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y

# ========== 默认账号/网络（由 files/ 覆盖，这里不写死）==========
# root 空密码由 base-files 默认行为保证
# IP 192.168.5.254 由 device/b60av21m/files/etc/config/network 提供

# ========== 关闭无关项 ==========
# 不编译线刷工具（只做 U 盘）
# CONFIG_PACKAGE_amlogic-usb-burning-tool is not set
# 关闭蓝牙（B60 无蓝牙）
# CONFIG_PACKAGE_kmod-bluetooth is not set
# 关闭音频（盒子用不到）
# CONFIG_PACKAGE_kmod-snd-soc-meson is not set
# 关闭 Docker 默认（内存紧张时先关，后续按需开）
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set

# ========== 签名/校验 ==========
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
CONFIG_PACKAGE_ucode-mod-ubus=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-ucode=y
