# ============================================================
# ImmWrt B60 AV21M (S905L3B) — 编译配置
# 平台: meson (Amlogic S905L3B)
# 基于: ImmortalWrt 24.10
# ============================================================

# ── 平台目标 ──
CONFIG_TARGET_meson=y
CONFIG_TARGET_meson_generic=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_meson_generic_DEVICE_meson-gxl-s905l3b-b60-av21m=y

# ── 内核 ──
CONFIG_LINUX_6_12=y
CONFIG_DEFAULT_SMALL_FLASH=n

# ── 根文件系统 ──
CONFIG_TARGET_ROOTFS_BTRFS=y
CONFIG_TARGET_ROOTFS_PARTSIZE=4096
CONFIG_TARGET_ROOTFS_CPIOGZ=y

# ── 引导 ──
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# ── 网络基础 ──
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y

# ── LuCI ──
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-proto-ipv6=y

# ── 系统工具 ──
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_tcpdump-mini=y

# ── 有线网络（B60 板载千兆）──
CONFIG_PACKAGE_kmod-dwmac-meson-gxl=y

# ── USB 3.0（S905L3B 有 USB3 口）──
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-dwc3-meson-g12a=y

# ── 防火墙/路由 ──
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_dnsmasq-full=y

# ── 关闭不需要的东西（精简镜像）──
# CONFIG_PACKAGE_kmod-brcmfmac is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_kmod-cfg80211 is not set
