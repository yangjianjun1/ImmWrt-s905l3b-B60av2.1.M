# ============================================
# B60 AV21M (S905L3B) 基础配置
# 平台：meson / generic / aarch64_cortex-a53
# 定位：纯有线网关，无无线，支持 USB 千兆网卡
# ============================================

# ---------- 目标平台 ----------
CONFIG_TARGET_meson=y
CONFIG_TARGET_meson_generic=y
CONFIG_HAS_SUBTARGETS=y
CONFIG_HAS_DEVICES=y
CONFIG_TARGET_BOARD="meson"
CONFIG_TARGET_SUBTARGET="generic"
CONFIG_TARGET_ARCH_PACKAGES="aarch64_cortex-a53"
CONFIG_CPU_TYPE="cortex-a53"

# 设备 profile（必须与 b60av21m.mk 里 define Device 名字一致）
CONFIG_TARGET_DEVICE_meson_generic_DEVICE_meson-gxl-s905l3b-b60-av21m=y

# ---------- 编译加速 ----------
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# ---------- 根文件系统格式 ----------
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_TARGET_ROOTFS_INITRAMfs=n
CONFIG_TARGET_ROOTFS_CPIOGZ=n
CONFIG_TARGET_ROOTFS_EXT4FS=n

# 分区大小（MiB），eMMC 建议留大一点
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# ---------- 基础系统 ----------
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_parted=y

# ---------- 网络基础 ----------
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_ip-full=y

# ---------- 以太网 / 存储驱动 ----------
CONFIG_PACKAGE_kmod-stmmac=y
CONFIG_PACKAGE_kmod-dwmac-meson-gxl=y
CONFIG_PACKAGE_kmod-meson-gxl-phy=y
CONFIG_PACKAGE_kmod-phylink=y
CONFIG_PACKAGE_kmod-libphy=y

# MMC / eMMC / SD
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-mmc-block=y
CONFIG_PACKAGE_kmod-sdhci=y

# USB2 / USB3
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-dwc3-meson-g12a=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

# USB 千兆网卡（RTL8153 等）
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_linux-firmware-rtl_nic=y

# ---------- LuCI ----------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-light=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-system-zh-cn=y

# 常用工具
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y

# ============================================
# 关闭所有无线相关（B60 无 WiFi 芯片）
# ============================================
# 内核级
CONFIG_WLAN=n
CONFIG_CFG80211=n
CONFIG_MAC80211=n

# 用户态工具
# CONFIG_PACKAGE_iw is not set
# CONFIG_PACKAGE_iwinfo is not set
# CONFIG_PACKAGE_wireless-tools is not set
# CONFIG_PACKAGE_hostapd is not set
# CONFIG_PACKAGE_hostapd-common is not set
# CONFIG_PACKAGE_wpad-openssl is not set
# CONFIG_PACKAGE_wpad-basic is not set
# CONFIG_PACKAGE_wpad-mini is not set

# 无线内核模块
# CONFIG_PACKAGE_kmod-cfg80211 is not set
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_kmod-brcmfmac is not set
# CONFIG_PACKAGE_kmod-mt7668 is not set
# CONFIG_PACKAGE_kmod-ath is not set
# CONFIG_PACKAGE_kmod-rtl8xxxu is not set

# LuCI 无线管理
# CONFIG_PACKAGE_luci-proto-wireless is not set
# CONFIG_PACKAGE_luci-app-wireless is not set
